{
  "name": "examenpadillamarco",
  "version": "1.0.0",
  "description": "API REST de usuarios con Express, ESLint y pruebas con Jest y Supertest",
  "main": "src/appPadillaMarco.js",
  "scripts": {
    "start": "node src/appPadillaMarco.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "api",
    "express",
    "rest",
    "jest",
    "eslint"
  ],
  "author": "Marco Adrian Padilla Triviño",
  "license": "ISC",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "testMatch": [
      "**/test/**/*.test.js"
    ]
  }
}
